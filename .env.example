# Splitwise OAuth Configuration

# Server-side secrets (do not expose to client)
SPLITWISE_CONSUMER_KEY=your_consumer_key_here
SPLITWISE_CONSUMER_SECRET=your_consumer_secret_here
SPLITWISE_REDIRECT_URI=http://localhost:3000/api/splitwise/auth

# Client-side variables (exposed to browser)
NEXT_PUBLIC_SPLITWISE_CONSUMER_KEY=your_consumer_key_here
NEXT_PUBLIC_SPLITWISE_REDIRECT_URI=http://localhost:3000/api/splitwise/auth
